generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model App {
  id           String   @id @default(cuid())
  title        String
  description  String
  url          String
  glyph        String
  colorVariant String   @default("custom")
  category     String   @default("Operations")
  sortOrder    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
